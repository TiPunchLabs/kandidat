# .envrc - Auto-create and activate the venv
if [[ ! -d .venv ]]; then
  uv venv
fi
source .venv/bin/activate

# Sync dependencies if uv.lock exists
if [[ -f uv.lock ]]; then
  uv sync
fi

# kandidat environment (dev | prod)
export KANDIDAT_ENV=prod

# Secrets via pass (password-store)
export SECRET_KEY=$(pass show kandidat/secret-key 2>/dev/null || echo "kandidat-dev-key")

# Enable experimental agent teams feature in Claude Code
export CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1

# PostgreSQL database URL (used by kandidat when set, falls back to SQLite otherwise)
export DATABASE_URL="postgresql+psycopg://kandidat:$(pass show kandidat/pg-password 2>/dev/null || echo 'kandidat')@localhost:5433/kandidat"

# Variables Terraform
TF_VAR_gitlab_token=$(pass gitlab/terraform-kandidat)
export TF_VAR_gitlab_token

TF_VAR_gitlab_namespace_id=$(pass gitlab/tipunchlabs-group-id)
export TF_VAR_gitlab_namespace_id

export TF_VAR_gitlab_namespace_path="tipunchlabs"

# Ansible Vault password
ANSIBLE_VAULT_PASSWORD=$(pass ansible/vault)
export ANSIBLE_VAULT_PASSWORD
